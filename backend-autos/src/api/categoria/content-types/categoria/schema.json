{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categorías",
    "description": "Agrupa los autos, por ejemplo SUV, sedán o camioneta"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 2,
      "maxLength": 100
    },
    "descripcion": {
      "type": "text"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "autos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::auto.auto",
      "mappedBy": "categoria"
    }
  }
}
